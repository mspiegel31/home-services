{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:enableMajor", ":pinDigests"],
  "packageRules": [
    {
      "description": "vLLM base images: digest updates weekly, majors need manual review (engine flag compatibility)",
      "matchDatasources": ["docker"],
      "matchFileNames": ["images/**"],
      "schedule": ["before 6am on monday"],
      "major": { "enabled": false }
    }
  ],
  "customManagers": []
}
