#!/command/with-contenv sh
# Fail-closed managed-configuration gate.
#
# Runs after 00-home-butler-seed (seeds the live config) and before s6-rc starts
# the gateway. If the managed snapshot at $HERMES_MANAGED_DIR exists, it MUST be
# valid and applied; an invalid or unbindable principal policy aborts startup so
# the gateway never reports ready without its authorization policy.
#
# If the snapshot is absent (sidecar sync pending), the gate fails open: the
# household-auth plugin still fails closed at load time on a missing/empty
# principals file, so the live gateway is never permissive once the plugin is
# enabled.
set -eu

home="${HERMES_HOME:-/opt/data}"
managed="${HERMES_MANAGED_DIR:-/opt/hermes-managed/current}"
if [ ! -d "$managed" ]; then
    echo "[managed-config] No snapshot at $managed; gateway starts unmanaged (git-sync pending)" >&2
    exit 0
fi

if [ ! -f "$managed/policy.yaml" ]; then
    echo "[managed-config] REFUSING startup: $managed/policy.yaml missing" >&2
    exit 1
fi

HERMES_HOME="$home" HERMES_MANAGED_DIR="$managed" /opt/hermes/.venv/bin/python3 /usr/local/bin/hermes-config-apply
