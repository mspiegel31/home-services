# Set in Portainer UI for the xberg stack (never committed).
# Long-lived Mealie API token — the bridge script reads it at runtime.
XBERG_MEALIE_TOKEN=<long-lived Mealie API token>
# LiteLLM master key — xberg uses it for VLM OCR + structured extraction
# (forwarded onto ocr.vlm_config / structured_extraction.llm).
XBERG_LLM_API_KEY=<litellm master key>
