# Paperclip portable home platform — environment template
#
# Copy this file to `.env` (never commit it; the root .gitignore already
# protects `.env`) and fill in every blank required value.
#
#   cp .env.example .env
#   chmod 600 .env
#
# The five required secrets are independent random values. Generate each one
# with `openssl rand -hex 32` (PAPERCLIP_SECRETS_MASTER_KEY is 32 bytes
# represented as 64 hex characters). Never reuse a value across installations,
# and never paste real values into chat, screenshots, or version control.
# Regenerating a value on an existing installation breaks authentication,
# agent/tool-action signatures, or stored-secret decryption — do not do it
# during upgrades.
#
# Shell environment variables override values in this file. When switching
# between installations on the same machine, unset any exported variables
# that would shadow the intended `.env` values.
#
# Blank values fail Compose interpolation before any container starts.

# --- Required secrets (fill in; leave blank only in this template) ---

# URL-safe hexadecimal database password.
PAPERCLIP_POSTGRES_PASSWORD=

# Persistent authentication secret.
BETTER_AUTH_SECRET=

# Persistent agent signing secret.
PAPERCLIP_AGENT_JWT_SECRET=

# Persistent tool-action signing secret.
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Persistent 32-byte hexadecimal encryption key (64 hex characters).
PAPERCLIP_SECRETS_MASTER_KEY=

# --- Nonsecret values ---

# Absolute, writable data root OUTSIDE this checkout. It must hold two
# subdirectories: app/ (the application home) and postgres/ (database state).
# The directories may be created empty; the upstream entrypoints initialize
# and own them. For a work/local install, $HOME/.local/share/paperclip is a
# sensible default — expand $HOME when writing the value, e.g.
# /Users/<you>/.local/share/paperclip. Leave blank only in this template.
PAPERCLIP_DATA_DIR=

# Host interface the app port is published on. 127.0.0.1 for local-only
# access; a LAN address (e.g. 192.168.1.39) for trusted-LAN/VPN installs.
PAPERCLIP_BIND_IP=127.0.0.1

# Host port for the application (container port is 3100).
PAPERCLIP_PORT=3100

# Canonical public URL including scheme and port. Must be the address users
# and the application use to reach the instance, e.g.
# http://localhost:3100 or http://192.168.1.39:3100.
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# true closes sign-up after the first owner has claimed the instance.
# Use a temporary `PAPERCLIP_AUTH_DISABLE_SIGN_UP=false` command-line
# override ONLY for the initial bootstrap, then bring the stack back up
# with the default true.
PAPERCLIP_AUTH_DISABLE_SIGN_UP=true

# Application heartbeat scheduler. Kept disabled for the platform-only
# posture: no agents, no scheduled jobs.
HEARTBEAT_SCHEDULER_ENABLED=false
