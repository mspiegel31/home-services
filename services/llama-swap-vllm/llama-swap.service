[Unit]
Description=llama-swap vLLM model router
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=llama-swap
Group=llama-swap
SupplementaryGroups=docker
EnvironmentFile=/etc/llama-swap/llama-swap.env
ExecStart=/usr/local/bin/llama-swap --config /etc/llama-swap/config.yaml --listen 0.0.0.0:11437 --watch-config
Restart=on-failure
RestartSec=5
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
