#!/command/with-contenv sh
# Create the native household profiles after upstream 02-reconcile-profiles has
# made /run/service writable, but before s6 starts gateway services.
set -eu

home="${HERMES_HOME:-/opt/data}"

ensure_profile() {
    name=$1
    profile="$home/profiles/$name"
    if [ -f "$profile/SOUL.md" ]; then
        return
    fi
    if [ -e "$profile" ]; then
        echo "[household-profiles] REFUSING startup: incomplete native profile at $profile" >&2
        exit 1
    fi
    echo "[household-profiles] Creating native profile $name"
    /command/s6-setuidgid hermes env HOME="$home" HERMES_HOME="$home" \
        hermes profile create "$name" --clone --no-alias
}

ensure_profile spouse
ensure_profile family
