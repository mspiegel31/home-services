#!/command/with-contenv sh
# Install locked household MCP projects into the persistent Hermes data volume.
# Runs after upstream 01-hermes-setup (UID remap + /opt/data ownership) and
# before upstream 02-reconcile-profiles starts profile gateways.
set -eu

home="${HERMES_HOME:-/opt/data}"
projects="$home/mcp"
cache="$home/.cache/uv"
stamp="$home/.household-mcp-projects"

mealie_ref=02183a84b92ba88e69fa11ded8b8235cc01771eb
babybuddy_ref=9f32d446241c323602b23160d05e926161184d9f
expected="mealie-mcp-server=$mealie_ref
babybuddy-mcp=$babybuddy_ref"
mealie="$projects/mealie-mcp-server"
babybuddy="$projects/babybuddy-mcp"
as_hermes() {
    /command/s6-setuidgid hermes env HOME="$home" "$@"
}


if [ -x "$mealie/.venv/bin/mealie-mcp-server" ] \
    && [ -x "$babybuddy/.venv/bin/babybuddy-mcp" ] \
    && [ -f "$stamp" ] \
    && [ "$(cat "$stamp")" = "$expected" ] \
    && [ "$(as_hermes git -C "$mealie" rev-parse HEAD 2>/dev/null || true)" = "$mealie_ref" ] \
    && [ "$(as_hermes git -C "$babybuddy" rev-parse HEAD 2>/dev/null || true)" = "$babybuddy_ref" ]; then
    echo "[household-mcp-tools] Pinned MCP projects already installed"
    exit 0
fi

as_hermes mkdir -p "$projects" "$cache"

sync_project() {
    name=$1
    destination=$2
    repository=$3
    revision=$4
    executable=$5

    current=""
    if [ -d "$destination/.git" ]; then
        current=$(as_hermes git -C "$destination" rev-parse HEAD 2>/dev/null || true)
    fi
    if [ "$current" != "$revision" ]; then
        echo "[household-mcp-tools] Fetching $name@$revision"
        as_hermes rm -rf "$destination"
        as_hermes git init "$destination"
        as_hermes git -C "$destination" remote add origin "$repository"
        as_hermes git -C "$destination" fetch --depth 1 origin "$revision"
        as_hermes git -C "$destination" checkout --detach FETCH_HEAD
        [ "$(as_hermes git -C "$destination" rev-parse HEAD)" = "$revision" ] || {
            echo "[household-mcp-tools] REFUSING startup: $name checkout did not match $revision" >&2
            exit 1
        }
    fi

    echo "[household-mcp-tools] Syncing locked $name environment"
    as_hermes env UV_CACHE_DIR="$cache" \
        uv sync --project "$destination" --frozen --no-dev --no-editable --python /usr/bin/python3.13
    [ -x "$destination/.venv/bin/$executable" ] || {
        echo "[household-mcp-tools] REFUSING startup: $name executable missing" >&2
        exit 1
    }
}

sync_project mealie-mcp-server "$mealie" https://github.com/rldiao/mealie-mcp-server.git "$mealie_ref" mealie-mcp-server
sync_project babybuddy-mcp "$babybuddy" https://github.com/babybuddy/babybuddy-mcp.git "$babybuddy_ref" babybuddy-mcp

printf '%s\n' "$expected" > "$stamp.tmp"
chown hermes:hermes "$stamp.tmp"
chmod 0644 "$stamp.tmp"
mv "$stamp.tmp" "$stamp"
echo "[household-mcp-tools] Pinned MCP projects ready"
